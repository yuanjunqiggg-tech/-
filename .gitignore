# 依赖
node_modules/
workers/node_modules/

# 构建产物
dist/
build/
*.apk
*.aab
*.keystore
.gradle/

# Capacitor 生成的 Android/iOS 工程（体积大且可重现）
#
# ★ 注意：这里必须写完整路径，不能用裸的 `android/`。
#   因为 `android/` 会匹配任意层级下名为 android 的目录，
#   会把 apk/agent-app/native-src/android/ 一起忽略掉 ——
#   而那里放的正是我们自己写的原生源码，必须进版本库。
apk/agent-app/android/
apk/agent-app/ios/

# 本地状态与凭据
agent_state.json
.env
.dev.vars
wrangler.local.toml
.wrangler/

# ★ 控制台构建产物 —— 里面内联了 PLATFORM_ACCESS_KEY，绝不能提交
.pages_dist/

# 备份文件
*.bak
*.orig

# 抓包与日志
tools/captured_prompts/*.json
!tools/captured_prompts/.gitkeep
*.log

# 系统
.DS_Store
Thumbs.db

# APK 分发副本（构建产物，不入库）
apk/dist/

# PyInstaller 产物（9MB 二进制，不入库；需要时用 tools 里的脚本重新打包）
agent/dist/
agent/build/
agent/prism-agent.spec
agent/agent_state.json
